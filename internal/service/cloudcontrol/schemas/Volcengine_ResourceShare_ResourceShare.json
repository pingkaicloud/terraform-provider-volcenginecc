    "filterableProperties": [
      "/properties/ResourceShareName",
      "/properties/Tags/*/Key",
      "/properties/Tags/*/Value",
      "/properties/ResourceShareTrn",
      "/properties/Status"
    ]
  },
  "handlers": {
    "create": {
      "permissions": [
        "resource_share:CreateResourceShare",
        "resource_share:DescribeResourceShares",
        "resource_share:ListResourceShareAssociations"
      ]
    },
    "delete": {
      "permissions": [
        "resource_share:DeleteResourceShare",
        "resource_share:DescribeResourceShares"
      ]
    },
    "list": {
      "permissions": [
        "resource_share:DescribeResourceShares"
      ]
    },
    "read": {
      "permissions": [
        "resource_share:DescribeResourceShares",
        "resource_share:ListResourceShareAssociations"
      ]
    },
    "update": {
      "permissions": [
        "resource_share:UpdateResourceShare",
        "resource_share:AssociateResourceShare",
        "resource_share:DisassociateResourceShare",
        "resource_share:TagResources",
        "resource_share:UntagResources",
        "resource_share:DescribeResourceShares",
        "resource_share:ListResourceShareAssociations"
      ]
    }
  },
  "primaryIdentifier": [
    "/properties/ResourceShareTrn"
