      "type": "string"
    },
    "CreateTime": {
      "description": "Creation time",
      "semantic": "createdTime",
      "type": "string"
    },
    "OwningAccountId": {
      "description": "Resource share unit creator account ID",
      "type": "integer"
    },
    "Principals": {
      "description": "Associated Principals (Principal refers to the recipient, which can be a user, organization, or organizational unit)",
      "type": "string"
    },
    "ResourceShareId": {
      "description": "Resource share unit ID",
      "type": "string"
    },
    "ResourceShareName": {
      "description": "Resource share unit name",
      "semantic": "resourceName",
      "type": "string"
    },
    "ResourceShareTrn": {
      "description": "Resource share unit Trn",
      "semantic": "resourceId",
      "type": "string"
    },
    "ResourceTrns": {
      "description": "Associated resources",
      "type": "string"
    },
    "Status": {
      "description": "Resource share unit status, including UNKNOWN - unknown status; ACTIVE - active status; DELETING - deleting status; DELETED - deleted status; FAILED - share failed status; NEW - newly created status",
      "semantic": "status",
      "type": "string"
    },
    "Tags": {
      "description": "Tag key-value pair",
      "insertionOrder": false,
      "items": {
        "$ref": "#/definitions/Tag"
      },
      "semantic": "tags",
      "type": "array",
      "uniqueItems": true
    },
    "UpdateTime": {
      "description": "Update time",
      "semantic": "updatedTime",
      "type": "string"
    }
  },
  "readOnlyProperties": [
    "/properties/ResourceShareTrn",
    "/properties/ResourceShareId",
    "/properties/OwningAccountId",
    "/properties/Status",
    "/properties/CreateTime",
    "/properties/UpdateTime"
  ],
  "required": [
    "ResourceShareName"
  ],
  "tagging": {
    "tagOnCreate": true,
    "tagUpdatable": true,
    "taggable": true
  },
