          "description": "Tag value",
          "type": "string"
        }
      },
      "required": [
        "Key"
      ],
      "type": "object"
    }
  },
  "description": "Volcano Engine Resource Share unit. Resource share units allow you to share resources under your account (such as subnets) with specified principals (Principal, which can be an account, organization, or organizational unit) for their use",
